    配色呼应「绿联」的品牌绿，比原来的纯深蓝更有辨识度。
    中间浅、边缘深，让前景的白色耳塞更突出。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF0A2E28" />
                <item android:offset="0.5" android:color="#FF12523F" />
                <item android:offset="1.0" android:color="#FF1C8F6B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
